<!DOCTYPE html>
<html lang="en">
<head>
  <title>NutriLog | Social Media</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    :root {
      --bg-1: #0f172a;
      --bg-2: #1e1b4b;
      --bg-3: #0f766e;
      --glass: rgba(255, 255, 255, 0.14);
      --glass-strong: rgba(255, 255, 255, 0.2);
      --border: rgba(255, 255, 255, 0.22);
      --text: #eef2ff;
      --text-dark: #172033;
      --muted: #cbd5e1;
      --muted-dark: #64748b;
      --panel: rgba(255, 255, 255, 0.82);
      --panel-soft: rgba(255, 255, 255, 0.7);
      --shadow-lg: 0 20px 60px rgba(2, 8, 23, 0.32);
      --shadow-md: 0 14px 30px rgba(15, 23, 42, 0.15);
      --radius-xl: 28px;
      --radius-lg: 22px;
      --radius-md: 16px;
      --blue: #4f46e5;
      --blue-2: #7c3aed;
      --pink: #ec4899;
      --teal: #14b8a6;
      --gold: #f59e0b;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at 10% 10%, rgba(236, 72, 153, 0.28), transparent 22%),
        radial-gradient(circle at 88% 14%, rgba(20, 184, 166, 0.22), transparent 22%),
        radial-gradient(circle at 50% 100%, rgba(99, 102, 241, 0.28), transparent 28%),
        linear-gradient(135deg, var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-3) 100%);
      min-height: 100vh;
    }

    body::before,
    body::after {
      content: "";
      position: fixed;
      inset: auto;
      width: 320px;
      height: 320px;
      border-radius: 50%;
      filter: blur(60px);
      opacity: 0.35;
      pointer-events: none;
      z-index: 0;
    }

    body::before {
      top: 90px;
      left: -90px;
      background: #7c3aed;
    }

    body::after {
      right: -100px;
      bottom: 40px;
      background: #ec4899;
    }

    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      padding: 18px 28px;
      background: rgba(15, 23, 42, 0.72);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 12px 34px rgba(0,0,0,0.22);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 30px;
      font-weight: 900;
      letter-spacing: -0.8px;
      color: #fff;
    }

    .logo img {
      width: 46px;
      height: 46px;
      object-fit: contain;
      border-radius: 14px;
      padding: 6px;
      background: linear-gradient(135deg, rgba(255,255,255,0.16), rgba(255,255,255,0.06));
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
    }

    .menu {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0;
      padding: 0;
      flex-wrap: wrap;
    }

    .menu li, .menu form { margin: 0; }

    .nav-btn {
      border: 0;
      border-radius: 999px;
      padding: 12px 20px;
      font-size: 14px;
      font-weight: 800;
      color: #fff;
      cursor: pointer;
      background: linear-gradient(135deg, var(--blue), var(--blue-2));
      box-shadow: 0 10px 24px rgba(79, 70, 229, 0.35);
      transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    }

    .nav-btn:hover {
      transform: translateY(-2px);
      filter: brightness(1.04);
      box-shadow: 0 16px 30px rgba(79, 70, 229, 0.42);
    }

    .page-wrap {
      position: relative;
      z-index: 1;
      max-width: 1320px;
      margin: 0 auto;
      padding: 28px 22px 50px;
    }

    .banner {
      position: relative;
      z-index: 1;
      max-width: 1320px;
      margin: 26px auto 0 auto;
      padding: 34px 36px;
      border-radius: 34px;
      background: linear-gradient(135deg, rgba(255,255,255,0.16), rgba(255,255,255,0.07));
      border: 1px solid rgba(255,255,255,0.18);
      backdrop-filter: blur(20px);
      box-shadow: var(--shadow-lg);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      overflow: hidden;
    }

    .banner::before {
      content: "";
      position: absolute;
      right: -60px;
      top: -60px;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(236,72,153,.55), rgba(236,72,153,0));
      pointer-events: none;
    }

    .banner::after {
      content: "";
      position: absolute;
      left: 22%;
      bottom: -80px;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(20,184,166,.35), rgba(20,184,166,0));
      pointer-events: none;
    }

    .banner-title {
      font-size: 62px;
      font-weight: 900;
      letter-spacing: -1.8px;
      margin: 0;
      color: #fff;
      position: relative;
      z-index: 1;
      text-shadow: 0 10px 30px rgba(0,0,0,0.18);
    }

    .banner-user {
      position: relative;
      z-index: 1;
      font-size: 16px;
      font-weight: 800;
      color: #fff;
      padding: 14px 20px;
      border-radius: 999px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      backdrop-filter: blur(10px);
    }

    .main-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 26px;
      align-items: start;
    }

    .main-column { min-width: 0; }

    .sidebar-column {
      position: sticky;
      top: 100px;
    }

    .card,
    .sidebar-card,
    .post-card {
      background: var(--panel);
      color: var(--text-dark);
      border: 1px solid rgba(255,255,255,0.5);
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(14px);
    }

    .card,
    .sidebar-card {
      border-radius: var(--radius-xl);
    }

    .card {
      padding: 28px;
      margin: 0 0 22px 0;
    }

    .sidebar-card {
      padding: 22px;
      margin-bottom: 20px;
    }

    .card h2,
    .sidebar-title,
    .comment-section h4 {
      margin-top: 0;
      margin-bottom: 18px;
      color: #0f172a;
      letter-spacing: -0.6px;
    }

    .card h2 {
      font-size: 34px;
      font-weight: 900;
    }

    .sidebar-title {
      font-size: 22px;
      font-weight: 900;
    }

    textarea,
    input[type="text"],
    input[type="file"] {
      width: 100%;
      padding: 15px 16px;
      border-radius: 18px;
      border: 1px solid #dbe4f0;
      background: rgba(255,255,255,0.9);
      color: #172033;
      font-size: 15px;
      transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }

    textarea:focus,
    input[type="text"]:focus,
    input[type="file"]:focus {
      outline: none;
      border-color: #a5b4fc;
      box-shadow: 0 0 0 5px rgba(99,102,241,.14);
      transform: translateY(-1px);
    }

    textarea {
      min-height: 145px;
      resize: vertical;
      line-height: 1.6;
    }

    .comment-form textarea { min-height: 84px; }

    .field-row { margin-top: 16px; }

    .field-row label {
      font-weight: 700;
      color: #243045;
      font-size: 15px;
    }

    .post-card {
      position: relative;
      border-radius: 28px;
      padding: 22px;
      margin-bottom: 20px;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.94) 0%, rgba(250,252,255,0.9) 100%);
    }

    .post-card::before {
      content: "";
      position: absolute;
      inset: 0 auto auto 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(90deg, var(--blue), var(--pink), var(--teal));
    }

    .post-user {
      font-weight: 900;
      font-size: 20px;
      margin-bottom: 8px;
      letter-spacing: -0.4px;
    }

    .post-content {
      white-space: pre-wrap;
      line-height: 1.72;
      margin: 16px 0 14px;
      font-size: 15px;
      color: #243045;
    }

    .post-image {
      width: 100%;
      max-height: 430px;
      display: block;
      object-fit: cover;
      margin: 16px 0;
      border-radius: 22px;
      border: 1px solid #dbe4f0;
      box-shadow: var(--shadow-md);
      background: #fff;
    }

    .muted {
      color: var(--muted-dark);
      font-size: 13px;
      line-height: 1.55;
    }

    .post-actions {
      margin-top: 16px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }

    .location-line,
    .tag-list,
    .likes-line {
      margin: 12px 0 0 0;
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.5;
      color: #334155;
      background: linear-gradient(135deg, rgba(99,102,241,0.09), rgba(236,72,153,0.05));
      border: 1px solid rgba(99,102,241,0.12);
    }

    .edit-box,
    .comment-edit-box {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid #e8edf5;
      display: none;
    }

    .comment-section {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #e8edf5;
    }

    .comment-item {
      margin-top: 12px;
      padding: 15px 16px;
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(245,248,255,0.95));
      border: 1px solid #e5ebf4;
      box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05);
    }

    .comment-user {
      font-weight: 800;
      margin-bottom: 7px;
      color: #0f172a;
    }

    .tag-suggestions {
      margin-top: 8px;
      border-radius: 18px;
      overflow: hidden;
      background: #fff;
      border: 1px solid #e2e8f0;
      box-shadow: var(--shadow-md);
    }

    .tag-suggestion-item {
      padding: 12px 14px;
      border-bottom: 1px solid #eef2f7;
      cursor: pointer;
      font-weight: 700;
      transition: background 0.18s ease;
    }

    .tag-suggestion-item:last-child { border-bottom: none; }

    .tag-suggestion-item:hover {
      background: linear-gradient(135deg, rgba(99,102,241,0.08), rgba(236,72,153,0.05));
    }

    .selected-tags { margin-top: 12px; }

    .selected-tag-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-right: 8px;
      margin-top: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      background: linear-gradient(135deg, rgba(99,102,241,0.14), rgba(236,72,153,0.12));
      border: 1px solid rgba(99,102,241,0.18);
      color: #4338ca;
      font-size: 13px;
      font-weight: 800;
    }

    .selected-tag-chip button {
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 15px;
      font-weight: 900;
      color: #4338ca;
      padding: 0;
      line-height: 1;
    }

    .follow-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 12px;
    }

    .follow-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding: 14px;
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255,255,255,0.95), rgba(244,247,255,0.92));
      border: 1px solid #e5ebf4;
      box-shadow: 0 10px 18px rgba(15,23,42,0.05);
    }

    .follow-name {
      font-weight: 800;
      line-height: 1.35;
      color: #1e293b;
    }

    .follow-form { margin: 0; }

    .flash-card {
      background: linear-gradient(135deg, rgba(255,247,237,0.95), rgba(255,255,255,0.92));
      border-color: #fdba74;
    }

    @media (max-width: 1100px) {
      .main-grid { grid-template-columns: 1fr; }
      .sidebar-column { position: static; }
    }

    @media (max-width: 820px) {
      .navbar {
        flex-direction: column;
        align-items: stretch;
      }

      .menu {
        justify-content: center;
      }

      .banner {
        padding: 24px 22px;
      }

      .banner-title {
        font-size: 42px;
      }

      .logo {
        font-size: 26px;
      }
    }

    @media (max-width: 560px) {
      .page-wrap {
        padding: 18px 14px 30px;
      }

      .card, .sidebar-card, .post-card {
        padding: 16px;
      }

      .banner-title {
        font-size: 34px;
      }

      .banner-user {
        width: 100%;
        text-align: center;
      }

      .nav-btn {
        width: 100%;
      }

      .menu li, .menu form {
        width: 100%;
      }
    }
  </style>

  <script>
    const ALL_USERS = {{ all_users|tojson }};

    function toggleCommentEdit(commentId) {
      const box = document.getElementById("edit-comment-box-" + commentId);
      if (!box) return;
      box.style.display = (box.style.display === "block") ? "none" : "block";
    }

    function toggleEdit(postId) {
      const box = document.getElementById("edit-box-" + postId);
      if (!box) return;
      box.style.display = (box.style.display === "block") ? "none" : "block";
    }

    function toggleLocationInput(boxId, checked) {
      const box = document.getElementById(boxId);
      if (!box) return;
      box.style.display = checked ? "block" : "none";
    }

    function toggleTagBox(boxId, checked) {
      const box = document.getElementById(boxId);
      if (!box) return;
      box.style.display = checked ? "block" : "none";
    }

    function getSelectedIds(containerId) {
      const container = document.getElementById(containerId);
      if (!container) return [];
      const hiddenInputs = container.querySelectorAll('input[name="tagged_user_ids"]');
      return Array.from(hiddenInputs).map(x => Number(x.value));
    }

    function showTagSuggestions(inputId, suggestionsId, selectedContainerId) {
      const input = document.getElementById(inputId);
      const suggestions = document.getElementById(suggestionsId);
      if (!input || !suggestions) return;

      const q = input.value.trim().toLowerCase();
      suggestions.innerHTML = "";

      if (!q) return;

      const selectedIds = getSelectedIds(selectedContainerId);

      const matches = ALL_USERS
        .filter(u =>
          !selectedIds.includes(Number(u.user_id)) &&
          u.user_name.toLowerCase().includes(q)
        )
        .slice(0, 5);

      for (const user of matches) {
        const div = document.createElement("div");
        div.className = "tag-suggestion-item";
        div.textContent = user.user_name;
        div.onclick = function () {
          addTaggedUser(selectedContainerId, user.user_id, user.user_name);
          input.value = "";
          suggestions.innerHTML = "";
        };
        suggestions.appendChild(div);
      }
    }

    function addTaggedUser(containerId, userId, userName) {
      const container = document.getElementById(containerId);
      if (!container) return;

      const existing = container.querySelector(`input[name="tagged_user_ids"][value="${userId}"]`);
      if (existing) return;

      const chip = document.createElement("span");
      chip.className = "selected-tag-chip";
      chip.setAttribute("data-user-id", userId);

      const label = document.createElement("span");
      label.textContent = "@" + userName;

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.textContent = "×";
      removeBtn.onclick = function () {
        chip.remove();
      };

      const hidden = document.createElement("input");
      hidden.type = "hidden";
      hidden.name = "tagged_user_ids";
      hidden.value = userId;

      chip.appendChild(label);
      chip.appendChild(removeBtn);
      chip.appendChild(hidden);

      container.appendChild(chip);
    }

    function preloadTags(containerId, tags) {
      if (!Array.isArray(tags)) return;
      for (const tag of tags) {
        addTaggedUser(containerId, tag.user_id, tag.user_name);
      }
    }
  </script>
</head>
<body>
  <nav class="navbar">
    <div class="logo">
      <img src="{{ url_for('static', filename='nutrilog_icon.png') }}" alt="NutriLog">
      <span>NutriLog</span>
    </div>

    <ul class="menu">
      <li>
        <form action="{{ home_url }}" method="get">
          <button type="submit" class="nav-btn">Home</button>
        </form>
      </li>
      <li>
        <form action="{{ food_url }}" method="get">
          <button type="submit" class="nav-btn">Add Food</button>
        </form>
      </li>
      <li>
        <form action="{{ logout_url }}" method="post">
          <button type="submit" class="nav-btn">Logout</button>
        </form>
      </li>
    </ul>
  </nav>

  <div class="banner">
    <div class="banner-title">Social Media</div>
    <div class="banner-user">
      Logged in as: {{ first_name }} {{ last_name }}
    </div>
  </div>

  <div class="page-wrap">
    {% if session.get("flash_msg") %}
      <div class="card flash-card">
        <div class="muted">{{ session.get("flash_msg") }}</div>
      </div>
      {% set _ = session.pop("flash_msg") %}
    {% endif %}

    <div class="main-grid">
      <div class="main-column">
        <div class="card">
          <h2>Create Post</h2>
          <form method="post" action="{{ url_for('social.create_post') }}" enctype="multipart/form-data">
            <textarea name="content" placeholder="Write something..."></textarea>

            <div class="field-row">
              <label>
                <input type="checkbox" name="add_location" onchange="toggleLocationInput('create-location-box', this.checked)">
                Add location
              </label>
            </div>

            <div class="field-row" id="create-location-box" style="display:none;">
              <input type="text" name="location_name" placeholder="Type a location name">
            </div>

            <div class="field-row">
              <label>
                <input type="checkbox" name="enable_tags" onchange="toggleTagBox('create-tag-box', this.checked)">
                Tag users
              </label>
            </div>

            <div class="field-row" id="create-tag-box" style="display:none;">
              <input
                type="text"
                id="tag-search-create"
                placeholder="Type a name to tag"
                autocomplete="off"
                oninput="showTagSuggestions('tag-search-create', 'tag-suggestions-create', 'selected-tags-create')"
              >
              <div id="tag-suggestions-create" class="tag-suggestions"></div>
              <div id="selected-tags-create" class="selected-tags"></div>
              <div class="muted">Start typing and click a suggestion.</div>
            </div>

            <div class="field-row">
              <label><b>Upload image</b></label>
              <input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.gif,.bmp,image/*">
            </div>

            <div class="post-actions">
              <button type="submit" class="nav-btn">Post</button>
            </div>
          </form>
        </div>

        <div class="card">
          <h2>Recent Posts</h2>

          {% if posts %}
            {% for post in posts %}
              <div class="post-card">
                <div class="post-user"><b>{{ post.user_name }}</b></div>

                {% if post.location_name %}
                  <div class="location-line">Location: {{ post.location_name }}</div>
                {% endif %}

                {% if post.tags %}
                  <div class="tag-list">
                    With:
                    {% for tag in post.tags %}
                      {{ tag.user_name }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                <div class="post-content">{{ post.content }}</div>

                {% if post.image_url %}
                  <img src="{{ post.image_url }}" alt="Post image" class="post-image">
                {% endif %}

                <div class="muted">
                  Created: {{ post.created_at }} |
                  Updated: {{ post.updated_at }}
                </div>

                <div class="post-actions">
                  {% if post.liked_by_current_user %}
                    <form method="post" action="{{ url_for('social.unlike_post', post_id=post.post_id) }}">
                      <button type="submit" class="nav-btn">Unlike</button>
                    </form>
                  {% else %}
                    <form method="post" action="{{ url_for('social.like_post', post_id=post.post_id) }}">
                      <button type="submit" class="nav-btn">Like</button>
                    </form>
                  {% endif %}

                  {% if post.user_id == current_user_id %}
                    <button type="button" class="nav-btn" onclick="toggleEdit({{ post.post_id }})">Edit</button>
                  {% endif %}
                </div>

                {% if post.likes %}
                  <div class="likes-line">
                    Liked by:
                    {% for like in post.likes %}
                      {{ like.user_name }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="likes-line">Liked by: nobody yet</div>
                {% endif %}

                {% if post.user_id == current_user_id %}
                  <div class="edit-box" id="edit-box-{{ post.post_id }}">
                    <form method="post" action="{{ url_for('social.edit_post', post_id=post.post_id) }}" enctype="multipart/form-data">
                      <textarea name="content">{{ post.content }}</textarea>

                      <div class="field-row">
                        <label>
                          <input
                            type="checkbox"
                            name="add_location"
                            onchange="toggleLocationInput('edit-location-box-{{ post.post_id }}', this.checked)"
                            {% if post.location_name %}checked{% endif %}
                          >
                          Add location
                        </label>
                      </div>

                      <div
                        class="field-row"
                        id="edit-location-box-{{ post.post_id }}"
                        style="display:{% if post.location_name %}block{% else %}none{% endif %};"
                      >
                        <input type="text" name="location_name" value="{{ post.location_name }}" placeholder="Type a location name">
                      </div>

                      <div class="field-row">
                        <label>
                          <input
                            type="checkbox"
                            name="enable_tags"
                            onchange="toggleTagBox('edit-tag-box-{{ post.post_id }}', this.checked)"
                            {% if post.tags %}checked{% endif %}
                          >
                          Tag users
                        </label>
                      </div>

                      <div
                        class="field-row"
                        id="edit-tag-box-{{ post.post_id }}"
                        style="display:{% if post.tags %}block{% else %}none{% endif %};"
                      >
                        <input
                          type="text"
                          id="tag-search-edit-{{ post.post_id }}"
                          placeholder="Type a name to tag"
                          autocomplete="off"
                          oninput="showTagSuggestions('tag-search-edit-{{ post.post_id }}', 'tag-suggestions-edit-{{ post.post_id }}', 'selected-tags-edit-{{ post.post_id }}')"
                        >
                        <div id="tag-suggestions-edit-{{ post.post_id }}" class="tag-suggestions"></div>
                        <div id="selected-tags-edit-{{ post.post_id }}" class="selected-tags"></div>
                        <div class="muted">Start typing and click a suggestion.</div>
                      </div>

                      <div class="field-row">
                        <label><b>Replace image</b></label>
                        <input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.gif,.bmp,image/*">
                      </div>

                      <div class="post-actions">
                        <button type="submit" class="nav-btn">Save Edit</button>
                      </div>
                    </form>
                  </div>

                  <script>
                    preloadTags("selected-tags-edit-{{ post.post_id }}", {{ post.tags|tojson }});
                  </script>
                {% endif %}

                <div class="comment-section">
                  <h4>Comments</h4>

                  {% if post.comments %}
                    {% for comment in post.comments %}
                      <div class="comment-item">
                        <div class="comment-user"><b>{{ comment.user_name }}</b></div>
                        <div class="post-content">{{ comment.comment_text }}</div>
                        <div class="muted">{{ comment.created_at }}</div>

                        {% if comment.user_id == current_user_id %}
                          <div class="post-actions">
                            <button
                              type="button"
                              class="nav-btn"
                              onclick="toggleCommentEdit({{ comment.comment_id }})"
                            >
                              Edit Comment
                            </button>
                          </div>

                          <div class="comment-edit-box" id="edit-comment-box-{{ comment.comment_id }}">
                            <form method="post" action="{{ url_for('social.edit_comment', comment_id=comment.comment_id) }}">
                              <textarea name="comment_text">{{ comment.comment_text }}</textarea>
                              <div class="post-actions">
                                <button type="submit" class="nav-btn">Save Comment</button>
                              </div>
                            </form>
                          </div>
                        {% endif %}
                      </div>
                    {% endfor %}
                  {% else %}
                    <p class="muted">No comments yet.</p>
                  {% endif %}

                  <form method="post" class="comment-form" action="{{ url_for('social.add_comment', post_id=post.post_id) }}">
                    <textarea name="comment_text" placeholder="Write a comment..."></textarea>
                    <div class="post-actions">
                      <button type="submit" class="nav-btn">Comment</button>
                    </div>
                  </form>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <p class="muted">No posts yet.</p>
          {% endif %}
        </div>
      </div>

      <div class="sidebar-column">
        <div class="sidebar-card">
          <h3 class="sidebar-title">Following</h3>
          {% if following_users %}
            <div class="follow-list">
              {% for user in following_users %}
                <div class="follow-item">
                  <div class="follow-name">{{ user.user_name }}</div>
                  <form class="follow-form" method="post" action="{{ url_for('social.unfollow_user', followed_user_id=user.user_id) }}">
                    <button type="submit" class="nav-btn">Unfollow</button>
                  </form>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <p class="muted">You are not following anyone yet.</p>
          {% endif %}
        </div>

        <div class="sidebar-card">
          <h3 class="sidebar-title">Suggested Users</h3>
          {% if suggested_users %}
            <div class="follow-list">
              {% for user in suggested_users %}
                <div class="follow-item">
                  <div class="follow-name">{{ user.user_name }}</div>
                  <form class="follow-form" method="post" action="{{ url_for('social.follow_user', followed_user_id=user.user_id) }}">
                    <button type="submit" class="nav-btn">Follow</button>
                  </form>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <p class="muted">No suggested users right now.</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</body>
</html>